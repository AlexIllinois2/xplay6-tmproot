# ---------------------------------------------------------------------------
# tools/: 源码白名单制。tools/ 第一层默认整体忽略, 只放行源码扩展名——
# 编译产物(无扩展名二进制/.o/.out/.so/.log/.apk)新增时零维护;
# 新源码请落在白名单扩展名 (.c/.h/.S/.sh/.py/.md/.txt/.xml/.json)。
# ---------------------------------------------------------------------------

# tools/ 第一层默认整体忽略
tools/*

# 源码扩展名白名单
!tools/*.c
!tools/*.h
!tools/*.S
!tools/*.sh
!tools/*.py
!tools/*.md
!tools/*.txt
!tools/*.xml
!tools/*.json

# 子目录单独放行 (tools/* 只作用于第一层)
!tools/apk/
!tools/mock/
!tools/suprobe/

# 特意入库的固化二进制与密钥 (1712 = 1.17.12 设备专用)
!tools/clobber1712
!tools/mpp1712
!tools/rootsh1712

# APK 打包: assets 同为白名单——只有源脚本入库,
# 二进制副本 (broot7/clobber/nsmbind/relayd/su/sud/sumount/sysoverlay/closefds)
# 由 tools/apk/build.sh 从 tools/ 复制生成; magisk_runtime.zip 由
# tools/build_magisk_module.sh 生成, 均不入库
tools/apk/stage/
tools/temproot.apk
tools/apk/demo/*.apk
tools/apk/assets/*
!tools/apk/assets/*.sh

# build/: 全部构建产物 (gdbpkg/magisk_runtime 模块树/zip/mgextract)
build/

# ---------------------------------------------------------------------------
# 本机 / 临时文件
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
*.swp
*~

# 三枚内核镜像只在本机（fw/ 符号链接到工作区根），gate 门禁要用，不入库
fw/
